  "cards": [
    {
      "dot": "cyan",
      "title": "同步运行时",
      "items": [
        "Shell、程序和 FileHandle 只面对内存 VFS；IndexedDB 延迟不污染同步调用链",
        "FileHandle 保留 inode 对象身份；已 detached 的 handle 不会把删除 inode 写回"
      ]
    },
    {
      "dot": "emerald",
      "title": "Delta 与一致性",
      "items": [
        "创建路径直接返回新 inode；每次变更登记为 put、delete 或 replaceAll",
        "meta 与 inodes 在同一事务提交；revision 不匹配时队列终止并 fail closed"
      ]
    },
    {
      "dot": "rose",
      "title": "启动与恢复",
      "items": [
        "Web Lock 限定单写者；/bin 来自代码镜像并在每次启动时只读挂载",
        "image 校验或加载失败时进入恢复模式，可导出原始存档后删除数据库重置"
      ]
    }
  ]
}
